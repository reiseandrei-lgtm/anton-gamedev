@@ -0,0 +1,91 @@
+using System.Linq;
+using System.Text.RegularExpressions;
+using Game.Chain;
+using Game.Hop;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace Game.Tests.EditMode
+{
+    /// Кейсы T-chain-01…07 из design/qa/test-plan-alpha.md.
+    public class ChainTests
+    {
+        private static ChainConfig Chain(float k1 = 1f, float k2 = 3.65f, int k3 = 8, int k4 = 0)
+        {
+            var c = ScriptableObject.CreateInstance<ChainConfig>();
+            c.minGap = k1; c.maxGap = k2; c.lookahead = k3; c.seed = k4;
+            return c;
+        }
+
+        private static HopConfig Hop(float k3 = 4f, float k4 = 0.35f)
+        {
+            var h = ScriptableObject.CreateInstance<HopConfig>();
+            h.minDistance = 1f; h.maxDistance = k3; h.landingTolerance = k4;
+            return h;
+        }
+
+        private static bool Roll(System.Random r) => r.NextDouble() < 0.35;
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-01")]
+        public void T_chain_01_first_lantern_at_zero_without_spark()
+        {
+            var g = new ChainGenerator(Chain(k4: 7), Hop(), _ => true);
+            Assert.AreEqual(0f, g.Lanterns[0].X);
+            Assert.IsFalse(g.Lanterns[0].HasSpark);
+            Assert.IsTrue(g.Lanterns[1].HasSpark, "роллер искры вызывается для остальных фонарей");
+        }
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-02")]
+        public void T_chain_02_gaps_within_range_and_uniform()
+        {
+            var g = new ChainGenerator(Chain(k1: 1f, k2: 3.65f, k3: 10000, k4: 7), Hop(), Roll);
+            var gaps = Enumerable.Range(0, 10000).Select(g.GapAfter).ToArray();
+            Assert.That(gaps.Min(), Is.GreaterThanOrEqualTo(1f));
+            Assert.That(gaps.Max(), Is.LessThanOrEqualTo(3.65f));
+            Assert.AreEqual(2.325, gaps.Average(), 0.05);
+        }
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-03")]
+        public void T_chain_03_max_gap_clamped_to_reach()
+        {
+            LogAssert.Expect(LogType.Warning, new Regex(@"chain#E1"));
+            var g = new ChainGenerator(Chain(k2: 5f, k3: 500, k4: 7), Hop(k3: 4f, k4: 0.35f), Roll);
+            Assert.AreEqual(3.65f, g.MaxGap, 1e-5f);
+            Assert.That(Enumerable.Range(0, 500).Max(g.GapAfter), Is.LessThanOrEqualTo(3.65f + 1e-5f));
+        }
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-04")]
+        public void T_chain_04_min_above_max_collapses()
+        {
+            LogAssert.Expect(LogType.Warning, new Regex(@"chain#E2"));
+            var g = new ChainGenerator(Chain(k1: 3f, k2: 2f, k3: 20, k4: 7), Hop(), Roll);
+            Assert.That(Enumerable.Range(0, 20).Select(g.GapAfter), Is.All.EqualTo(2f).Within(1e-5f));
+        }
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-05")]
+        public void T_chain_05_lookahead_after_landing()
+        {
+            var g = new ChainGenerator(Chain(k3: 8, k4: 7), Hop(), Roll);
+            g.EnsureAhead(5);
+            Assert.That(g.Lanterns.Count - 1 - 5, Is.GreaterThanOrEqualTo(8));
+        }
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-06")]
+        public void T_chain_06_same_seed_same_chain()
+        {
+            var a = new ChainGenerator(Chain(k3: 50, k4: 42), Hop(), Roll);
+            var b = new ChainGenerator(Chain(k3: 50, k4: 42), Hop(), Roll);
+            Assert.AreEqual(a.Lanterns.Select(l => (l.X, l.HasSpark)).ToArray(), b.Lanterns.Select(l => (l.X, l.HasSpark)).ToArray());
+        }
+
+        [Test, NUnit.Framework.Property("TID", "T-chain-07")]
+        public void T_chain_07_seed_zero_differs()
+        {
+            var a = new ChainGenerator(Chain(k3: 20, k4: 0), Hop(), Roll, seed: null);
+            var b = new ChainGenerator(Chain(k3: 20, k4: 0), Hop(), Roll, seed: null);
+            Assert.AreNotEqual(a.Seed, b.Seed);
+            Assert.AreNotEqual(a.Lanterns.Select(l => l.X).ToArray(), b.Lanterns.Select(l => l.X).ToArray());
+        }
+    }
+}
