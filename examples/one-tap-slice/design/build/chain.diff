@@ -0,0 +1,46 @@
+using System.Collections;
+using System.Linq;
+using Game.Chain;
+using Game.Hop;
+using Game.Presentation;
+using Game.Spark;
+using NUnit.Framework;
+using UnityEngine;
+using UnityEngine.TestTools;
+
+namespace Game.Tests.PlayMode
+{
+    /// T-chain-08 (ED-chain-2): сцена строит цепочку только через ChainGenerator.
+    public class ChainSceneTests
+    {
+        private GameObject go;
+
+        [UnityTearDown]
+        public IEnumerator Cleanup()
+        {
+            if (go != null) Object.Destroy(go);
+            foreach (var cam in Object.FindObjectsByType<Camera>(FindObjectsSortMode.None)) Object.Destroy(cam.gameObject);
+            foreach (var p in Object.FindObjectsByType<PlayerHop>(FindObjectsSortMode.None)) Object.Destroy(p.gameObject);
+            yield return null;
+        }
+
+        [UnityTest, NUnit.Framework.Property("TID", "T-chain-08")]
+        public IEnumerator T_chain_08_scene_uses_generator()
+        {
+            var hop = Resources.Load<HopConfig>("Config/HopConfig");
+            var spark = Resources.Load<SparkConfig>("Config/SparkConfig");
+            var chain = Resources.Load<ChainConfig>("Config/ChainConfig");
+            go = new GameObject("Game");
+            go.SetActive(false);
+            var gb = go.AddComponent<GameBootstrap>();
+            gb.UseConfigs(hop, spark, chain, 42);
+            go.SetActive(true);
+            yield return null;
+
+            var expected = new ChainGenerator(chain, hop, r => SparkPlacer.Roll(r, spark), 42);
+            var xs = gb.LanternPositions.Select(p => p.x).ToArray();
+            Assert.AreEqual(expected.Lanterns.Count, xs.Length);
+            for (int i = 0; i < xs.Length; i++) Assert.AreEqual(expected.Lanterns[i].X, xs[i], 1e-4f, $"фонарь {i}");
+        }
+    }
+}
