+using System;
+using System.Collections.Generic;
+using Game.Hop;
+using UnityEngine;
+
+namespace Game.Chain
+{
+    public readonly struct Lantern
+    {
+        public readonly float X;
+        public readonly bool HasSpark;
+        public Lantern(float x, bool hasSpark) { X = x; HasSpark = hasSpark; }
+    }
+
+    /// Цепочка фонарей (gdd/chain.md). Чистый класс: проверяется EditMode-тестами.
+    public sealed class ChainGenerator
+    {
+        private static readonly System.Random SeedSource = new System.Random();
+
+        private readonly List<Lantern> lanterns = new List<Lantern>();
+        private readonly System.Random rng;
+        private readonly Func<System.Random, bool> sparkRoll;
+        private readonly int lookahead;
+
+        public int Seed { get; }
+        public float MinGap { get; }
+        public float MaxGap { get; }
+        public IReadOnlyList<Lantern> Lanterns => lanterns;
+        public event Action<int> LanternAdded;
+
+        /// sparkRoll — бросок искры системы spark (spark#R1) на том же генераторе, чтобы seed воспроизводил и искры (chain#R5).
+        /// seed: явный (тесты, эталоны) → K4 из конфига → новый случайный при K4 = 0 (chain#E3).
+        public ChainGenerator(ChainConfig chain, HopConfig hop, Func<System.Random, bool> sparkRoll, int? seed = null)
+        {
+            this.sparkRoll = sparkRoll;
+            lookahead = chain.lookahead;
+            float reach = hop.maxDistance - hop.landingTolerance;
+            MaxGap = chain.maxGap;
+            if (MaxGap > reach)                                         // chain#R3, chain#E1
+            {
+                Debug.LogWarning($"[chain#E1] maxGap {chain.maxGap} > hop#K3 − hop#K4 = {reach}: беру {reach}");
+                MaxGap = reach;
+            }
+            MinGap = chain.minGap;
+            if (MinGap > MaxGap)                                        // chain#E2
+            {
+                Debug.LogWarning($"[chain#E2] minGap {chain.minGap} > maxGap {MaxGap}: беру {MaxGap}");
+                MinGap = MaxGap;
+            }
+            lock (SeedSource) Seed = seed ?? (chain.seed != 0 ? chain.seed : SeedSource.Next(1, int.MaxValue));
+            rng = new System.Random(Seed);
+            Add(0f, false);                                             // chain#R1
+            EnsureAhead(0);
+        }
+
+        /// chain#R4: впереди фонаря index не меньше lookahead фонарей.
+        public void EnsureAhead(int index)
+        {
+            while (lanterns.Count - 1 - index < lookahead)
+            {
+                float gap = MinGap + (float)rng.NextDouble() * (MaxGap - MinGap);   // chain#F1
+                Add(lanterns[lanterns.Count - 1].X + gap, sparkRoll(rng));
+            }
+        }
+
+        public float GapAfter(int index) => lanterns[index + 1].X - lanterns[index].X;
+
+        private void Add(float x, bool hasSpark)
+        {
+            lanterns.Add(new Lantern(x, hasSpark));
+            LanternAdded?.Invoke(lanterns.Count - 1);
+        }
+    }
+}
